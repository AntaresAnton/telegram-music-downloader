# ==============================================================================
# Telegram Audio Downloader - Variables de entorno
# ==============================================================================
# Copia este archivo como `.env` y completa tus credenciales reales.
# NUNCA subas el archivo `.env` ni archivos `*.session` al repositorio.

# --- Telegram API (Obligatorio) -----------------------------------------------
# Obtén tu API_ID y API_HASH en https://my.telegram.org (API development tools)
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# Nombre base del archivo de sesión de Telethon (opcional)
SESSION_NAME=telegram_audio_session

# --- Proveedor de IA para enriquecimiento de metadatos (Opcional) -------------
# Valores sugeridos: together | ollama (dejar vacío para deshabilitar)
AI_PROVIDER=

# Together AI (requerido solo si AI_PROVIDER=together)
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Ollama local (requerido solo si AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
